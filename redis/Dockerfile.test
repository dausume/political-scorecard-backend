# PSC test cache — KeyDB (protocol-compatible Redis fork; same image family as
# the suite's prf-keydb). Replaces the former bitnami/redis:7.4 base, a tag
# removed from Docker Hub that made the test stack unbuildable.
FROM eqalpha/keydb:latest

# The test conf sets port 6800 and the ACL user the Spring test profile
# authenticates with (psc-server-test / pscpassword).
COPY ./redis-config/test/redis-test.conf /etc/keydb/keydb.conf

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD keydb-cli -p 6800 --user psc-server-test --pass pscpassword ping | grep -q PONG || exit 1

# The base image's entrypoint drops root and runs this against /data.
CMD ["keydb-server", "/etc/keydb/keydb.conf"]
